SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
DATABASE_URL=sqlite:///./react_club.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Cloud Console > APIs & Services > Credentials 에서 만든 OAuth 2.0 Client ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
# 최초 관리자로 등록할 구글 이메일(쉼표 구분). 이후엔 root 계정이 관리자 페이지에서 추가/삭제 가능.
ADMIN_EMAILS=

# 문의하기 폼 메일 발송용 (README "문의 메일 켜는 방법" 참고). Gmail이면 앱 비밀번호를 써야 해요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 문의 메일을 받을 주소. 비워두면 SMTP_USERNAME으로 감.
CONTACT_TO_EMAIL=
