# docker-compose 배포용 환경변수. 복사해서 .env로 저장하고 값을 채운 뒤 `docker compose up -d --build`.

# --- backend ---
SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
ALLOWED_ORIGINS=https://react.bssm.dev

# Google Cloud Console에서 발급한 OAuth Client ID (README 참고). 비워두면 구글 로그인 버튼이 숨겨져요.
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=

# --- frontend (빌드 타임에 들어감) ---
VITE_GOOGLE_CLIENT_ID=

# --- mysql ---
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=react_club
MYSQL_USER=react_admin
MYSQL_PASSWORD=change-this-db-password

# --- cloudflare tunnel (README "Cloudflare Tunnel로 도메인 연결하기" 참고) ---
CLOUDFLARE_TUNNEL_TOKEN=
